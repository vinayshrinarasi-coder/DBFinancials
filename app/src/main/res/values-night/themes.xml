<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DBFinancials" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryContainer</item>
        <item name="colorOnPrimary">@color/onPrimaryContainer</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/onPrimary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryContainer</item>
        <item name="colorOnSecondary">@color/onSecondaryContainer</item>

        <!-- Tertiary brand color. -->
        <item name="colorTertiary">@color/tertiaryContainer</item>
        <item name="colorOnTertiary">@color/onTertiaryContainer</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Surface and Background -->
        <item name="android:colorBackground">@color/onBackground</item>
        <item name="colorSurface">@color/onSurfaceVariant</item>
        <item name="colorOnSurface">@color/background</item>
    </style>

    <style name="AppTheme" parent="Theme.DBFinancials" />
    <style name="AppTheme.NoActionBar" parent="Theme.DBFinancials" />
</resources>
